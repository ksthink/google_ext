{
  "manifest_version": 3,
  "name": "드래그 영어 번역",
  "version": "0.1.0",
  "description": "영어 문장을 드래그하면 마우스 아래 툴팁으로 한국어 번역을 보여줍니다.",
  "minimum_chrome_version": "138",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
